                    <default>false</default>
                    <label>Recall</label>
                </value>
                <value>
                    <fullName>Warranty Repair</fullName>
                    <default>false</default>
                    <label>Warranty Repair</label>
                </value>
                <value>
                    <fullName>General Maintenance</fullName>
                    <default>true</default>
                    <label>General Maintenance</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Detailed description of the service work performed or needed.</description>
