    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores configuration for round-robin Lead assignment pools including active state and fallback ownership settings.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Read</externalSharingModel>
    <fields>
        <fullName>Description__c</fullName>
        <description>Administrative notes describing the purpose and scope of this round-robin configuration.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter notes about this round-robin pool configuration.</inlineHelpText>
        <label>Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Fallback_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>User who receives Lead ownership when no round-robin pool members are available for assignment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user who should receive Leads when no pool members are available.</inlineHelpText>
        <label>Fallback Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Round_Robin_Configs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether this round-robin configuration is currently active and processing Lead assignments.</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to activate this round-robin pool for Lead assignment.</inlineHelpText>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Round Robin Config</label>
    <nameField>
        <displayFormat>RRC-{00000}</displayFormat>
        <label>Round Robin Config Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Configs</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
