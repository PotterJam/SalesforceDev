<aura:component controller="AccountWorkflowStatusController"
                implements="flexipage:availableForRecordHome,force:hasRecordId">

    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="workflowStatus" type="Object" />
    <aura:attribute name="activities" type="Object[]" />
    <aura:attribute name="isLoading" type="Boolean" default="true" />
    <aura:attribute name="errorMessage" type="String" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <lightning:card title="Workflow Status" iconName="standard:flow">
        <aura:if isTrue="{!v.isLoading}">
            <lightning:spinner alternativeText="Loading" size="small" />
        </aura:if>

        <aura:if isTrue="{!v.errorMessage}">
            <div class="slds-p-around_medium">
                <ui:message severity="error">{!v.errorMessage}</ui:message>
            </div>
        </aura:if>

        <aura:if isTrue="{!and(!v.isLoading, !v.errorMessage)}">
            <div class="slds-p-around_medium">
                <aura:if isTrue="{!v.workflowStatus}">
                    <div class="slds-grid slds-wrap">
                        <div class="slds-col slds-size_1-of-2 slds-p-bottom_small">
                            <span class="slds-text-title_caps">Alert Name</span>
                            <p class="slds-text-body_regular">{!v.workflowStatus.alertName}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-2 slds-p-bottom_small">
                            <span class="slds-text-title_caps">Description</span>
                            <p class="slds-text-body_regular">{!v.workflowStatus.description}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-2 slds-p-bottom_small">
                            <span class="slds-text-title_caps">Recipient Type</span>
                            <p class="slds-text-body_regular">{!v.workflowStatus.recipientType}</p>
                        </div>
                        <div class="slds-col slds-size_1-of-2 slds-p-bottom_small">
                            <span class="slds-text-title_caps">Email Template</span>
                            <p class="slds-text-body_regular">{!v.workflowStatus.emailTemplate}</p>
                        </div>
                    </div>
                </aura:if>

                <aura:if isTrue="{!v.activities.length > 0}">
                    <h3 class="slds-text-heading_small slds-p-top_medium slds-p-bottom_x-small">Recent Activity</h3>
                    <table class="slds-table slds-table_bordered slds-table_cell-buffer">
                        <thead>
                            <tr class="slds-line-height_reset">
                                <th scope="col"><div class="slds-truncate">Subject</div></th>
                                <th scope="col"><div class="slds-truncate">Date</div></th>
                                <th scope="col"><div class="slds-truncate">Status</div></th>
                            </tr>
                        </thead>
                        <tbody>
                            <aura:iteration items="{!v.activities}" var="activity">
                                <tr>
                                    <td><div class="slds-truncate">{!activity.subject}</div></td>
                                    <td><div class="slds-truncate">{!activity.activityDate}</div></td>
                                    <td><div class="slds-truncate">{!activity.status}</div></td>
                                </tr>
                            </aura:iteration>
                        </tbody>
                    </table>
                </aura:if>
            </div>
        </aura:if>
    </lightning:card>
</aura:component>
