    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks awarded grants including financial totals, grant periods, and reporting requirements.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Award_Title__c</fullName>
        <description>The title of the awarded grant.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the title of this grant award.</inlineHelpText>
        <label>Award Title</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Application__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The application that resulted in this award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the application that was approved for this award.</inlineHelpText>
        <label>Application</label>
        <referenceTo>Grant_Application__c</referenceTo>
        <relationshipLabel>Grant Awards</relationshipLabel>
        <relationshipName>Grant_Awards</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Funder__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The funding organization that made this award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the funder for this award.</inlineHelpText>
        <label>Funder</label>
        <referenceTo>Grant_Funder__c</referenceTo>
        <relationshipLabel>Grant Awards</relationshipLabel>
        <relationshipName>Grant_Awards</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount_Awarded__c</fullName>
        <description>The total amount awarded for this grant.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the total amount awarded.</inlineHelpText>
        <label>Amount Awarded</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Amount_Received__c</fullName>
        <description>The total amount received to date for this award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total payments received to date.</inlineHelpText>
        <label>Amount Received</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Amount_Remaining__c</fullName>
        <description>The amount still outstanding on this award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Amount still to be received.</inlineHelpText>
        <label>Amount Remaining</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Start_Date__c</fullName>
        <description>The start date of the grant period.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the grant period start date.</inlineHelpText>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
        <description>The end date of the grant period.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the grant period end date.</inlineHelpText>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current status of this grant award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current status of this award.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>true</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>On Hold</fullName>
                    <default>false</default>
                    <label>On Hold</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Terminated</fullName>
                    <default>false</default>
                    <label>Terminated</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Reporting_Frequency__c</fullName>
        <description>How often reporting is required for this award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select how often reports are required.</inlineHelpText>
        <label>Reporting Frequency</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Monthly</fullName>
                    <default>false</default>
                    <label>Monthly</label>
                </value>
                <value>
                    <fullName>Quarterly</fullName>
                    <default>true</default>
                    <label>Quarterly</label>
                </value>
                <value>
                    <fullName>Semi-Annual</fullName>
                    <default>false</default>
                    <label>Semi-Annual</label>
                </value>
                <value>
                    <fullName>Annual</fullName>
                    <default>false</default>
                    <label>Annual</label>
                </value>
                <value>
                    <fullName>Final Only</fullName>
                    <default>false</default>
                    <label>Final Only</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Next_Report_Due__c</fullName>
        <description>The next reporting deadline for this award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the next reporting deadline.</inlineHelpText>
        <label>Next Report Due</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Internal notes about this grant award.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any internal notes about this award.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Grant Award</label>
    <nameField>
        <displayFormat>GW-{00000}</displayFormat>
        <label>Grant Award Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Grant Awards</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
