    <deploymentStatus>Deployed</deploymentStatus>
    <description>A fundraising initiative or campaign that organizes fundraising efforts around a specific goal, timeframe, and strategy.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Start_Date__c</fullName>
        <description>The date when the fundraising campaign officially begins.</description>
        <externalId>false</externalId>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
        <description>The date when the fundraising campaign is scheduled to conclude.</description>
        <externalId>false</externalId>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Goal_Amount__c</fullName>
        <description>The target fundraising amount for this campaign.</description>
        <externalId>false</externalId>
        <label>Goal Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Amount_Raised__c</fullName>
        <description>The total amount raised so far in this campaign.</description>
        <externalId>false</externalId>
        <label>Amount Raised</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current status of the fundraising campaign.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Planned</fullName>
                    <default>true</default>
                    <label>Planned</label>
                </value>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Campaign_Type__c</fullName>
        <description>The type or category of the fundraising campaign.</description>
        <externalId>false</externalId>
        <label>Campaign Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Annual Fund</fullName>
                    <default>false</default>
                    <label>Annual Fund</label>
                </value>
                <value>
                    <fullName>Capital Campaign</fullName>
                    <default>false</default>
                    <label>Capital Campaign</label>
                </value>
                <value>
                    <fullName>Endowment</fullName>
                    <default>false</default>
                    <label>Endowment</label>
                </value>
                <value>
                    <fullName>Event</fullName>
                    <default>false</default>
                    <label>Event</label>
                </value>
                <value>
                    <fullName>Grant</fullName>
                    <default>false</default>
                    <label>Grant</label>
                </value>
                <value>
                    <fullName>Major Gifts</fullName>
                    <default>false</default>
                    <label>Major Gifts</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Detailed description of the campaign's purpose, strategy, and target audience.</description>
        <externalId>false</externalId>
        <label>Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Percent_To_Goal__c</fullName>
        <description>Calculated percentage of the goal amount that has been raised so far.</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Goal_Amount__c) || Goal_Amount__c = 0, 0, Amount_Raised__c / Goal_Amount__c * 100)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Percent To Goal</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <validationRules>
        <fullName>Campaign_End_Date_After_Start</fullName>
        <active>true</active>
        <description>Ensures the campaign end date is not before the start date.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(End_Date__c)), NOT(ISBLANK(Start_Date__c)), End_Date__c &lt; Start_Date__c)</errorConditionFormula>
        <errorDisplayField>End_Date__c</errorDisplayField>
        <errorMessage>End Date must be on or after Start Date.</errorMessage>
    </validationRules>
    <label>Fundraising Campaign</label>
    <nameField>
        <label>Campaign Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Fundraising Campaigns</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
