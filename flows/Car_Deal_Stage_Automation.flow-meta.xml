            <value>
                <stringValue>Sold</stringValue>
            </value>
        </inputAssignments>
        <object>Vehicle__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Vehicle_Available</name>
        <label>Update Vehicle Available</label>
        <locationX>528</locationX>
        <locationY>551</locationY>
        <faultConnector>
