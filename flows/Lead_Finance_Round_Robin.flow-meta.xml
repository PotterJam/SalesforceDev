    <description>Assigns new Leads to finance pipeline team members in a round-robin rotation. Reads the roster from Finance_Pipeline_Round_Robin__mdt and tracks position via Round_Robin_Counter__c.</description>
    <environments>Default</environments>
    <formulas>
