    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks specific funding opportunities available from funders that can be pursued.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Opportunity_Name__c</fullName>
        <description>The title of the funding opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the title of this funding opportunity.</inlineHelpText>
        <label>Opportunity Name</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Funder__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The funding organization that offers this opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the funder offering this opportunity.</inlineHelpText>
        <label>Funder</label>
        <referenceTo>Grant_Funder__c</referenceTo>
        <relationshipLabel>Grant Opportunities</relationshipLabel>
        <relationshipName>Grant_Opportunities</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount_Available__c</fullName>
        <description>The maximum grant amount available for this opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the maximum grant amount available.</inlineHelpText>
        <label>Amount Available</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Stage__c</fullName>
        <description>The current stage of pursuit for this opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current stage of this opportunity.</inlineHelpText>
        <label>Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Identified</fullName>
                    <default>true</default>
                    <label>Identified</label>
                </value>
                <value>
                    <fullName>Researching</fullName>
                    <default>false</default>
                    <label>Researching</label>
                </value>
                <value>
                    <fullName>Ready to Apply</fullName>
                    <default>false</default>
                    <label>Ready to Apply</label>
                </value>
                <value>
                    <fullName>Applied</fullName>
                    <default>false</default>
                    <label>Applied</label>
                </value>
                <value>
                    <fullName>Closed</fullName>
                    <default>false</default>
                    <label>Closed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Deadline__c</fullName>
        <description>The application deadline for this funding opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the application deadline date.</inlineHelpText>
        <label>Deadline</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Eligibility_Criteria__c</fullName>
        <description>The eligibility requirements for applicants.</description>
        <externalId>false</externalId>
        <inlineHelpText>Describe the eligibility criteria for this opportunity.</inlineHelpText>
        <label>Eligibility Criteria</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Match_Required__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether matching funds are required for this opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Check if matching funds are required.</inlineHelpText>
        <label>Match Required</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Match_Percentage__c</fullName>
        <description>The required match percentage if matching funds are needed.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the required match percentage.</inlineHelpText>
        <label>Match Percentage</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Priority__c</fullName>
        <description>The internal priority level assigned to this opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the priority level for pursuing this opportunity.</inlineHelpText>
        <label>Priority</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>true</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>Low</fullName>
                    <default>false</default>
                    <label>Low</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Assigned_Writer__c</fullName>
        <description>The grant writer assigned to pursue this opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the name of the assigned grant writer.</inlineHelpText>
        <label>Assigned Writer</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Internal notes about this funding opportunity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any internal notes about this opportunity.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Whether this opportunity is currently open for applications.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current availability status.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Open</fullName>
                    <default>true</default>
                    <label>Open</label>
                </value>
                <value>
                    <fullName>Expired</fullName>
                    <default>false</default>
                    <label>Expired</label>
                </value>
                <value>
                    <fullName>Withdrawn</fullName>
                    <default>false</default>
                    <label>Withdrawn</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Grant Opportunity</label>
    <nameField>
        <displayFormat>GO-{00000}</displayFormat>
        <label>Grant Opportunity Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Grant Opportunities</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
