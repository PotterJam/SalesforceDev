        </connector>
    </assignments>
    <assignments>
        <name>Fault_Handler_Sold</name>
        <label>Capture Fault Vehicle Sold</label>
        <locationX>44</locationX>
        <locationY>671</locationY>
        <assignmentItems>
            <assignToReference>FaultMessage</assignToReference>
            <operator>Assign</operator>
