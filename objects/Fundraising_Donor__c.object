    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents an individual or organizational donor in the fundraising pipeline. Tracks contact details, giving preferences, and lifetime donation history.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Donor_Type__c</fullName>
        <description>Classifies the donor as an individual, organization, foundation, or government entity.</description>
        <externalId>false</externalId>
        <label>Donor Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Individual</fullName>
                    <default>true</default>
                    <label>Individual</label>
                </value>
                <value>
                    <fullName>Organization</fullName>
                    <default>false</default>
                    <label>Organization</label>
                </value>
                <value>
                    <fullName>Foundation</fullName>
                    <default>false</default>
                    <label>Foundation</label>
                </value>
                <value>
                    <fullName>Government</fullName>
                    <default>false</default>
                    <label>Government</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>First_Name__c</fullName>
        <description>The donor's first name, used for individual donor records.</description>
        <externalId>false</externalId>
        <label>First Name</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Last_Name__c</fullName>
        <description>The donor's last name, used for individual donor records.</description>
        <externalId>false</externalId>
        <label>Last Name</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Organization_Name__c</fullName>
        <description>The name of the organization, foundation, or government entity when the donor is not an individual.</description>
        <externalId>false</externalId>
        <label>Organization Name</label>
        <length>120</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Email__c</fullName>
        <description>Primary email address for donor communications and acknowledgment letters.</description>
        <externalId>false</externalId>
        <label>Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phone__c</fullName>
        <description>Primary phone number for the donor.</description>
        <externalId>false</externalId>
        <label>Phone</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Phone</type>
    </fields>
    <fields>
        <fullName>Preferred_Contact_Method__c</fullName>
        <description>The donor's preferred method of communication for solicitations and updates.</description>
        <externalId>false</externalId>
        <label>Preferred Contact Method</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Email</fullName>
                    <default>true</default>
                    <label>Email</label>
                </value>
                <value>
                    <fullName>Phone</fullName>
                    <default>false</default>
                    <label>Phone</label>
                </value>
                <value>
                    <fullName>Mail</fullName>
                    <default>false</default>
                    <label>Mail</label>
                </value>
                <value>
                    <fullName>No Contact</fullName>
                    <default>false</default>
                    <label>No Contact</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Do_Not_Solicit__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates the donor has requested not to be solicited for donations.</description>
        <externalId>false</externalId>
        <label>Do Not Solicit</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Lifetime_Giving__c</fullName>
        <description>The cumulative total of all gifts received from this donor over their lifetime.</description>
        <externalId>false</externalId>
        <label>Lifetime Giving</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>First_Gift_Date__c</fullName>
        <description>The date of the first gift received from this donor.</description>
        <externalId>false</externalId>
        <label>First Gift Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Last_Gift_Date__c</fullName>
        <description>The date of the most recent gift received from this donor.</description>
        <externalId>false</externalId>
        <label>Last Gift Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Free-form notes about the donor, such as relationship history, interests, or special instructions.</description>
        <externalId>false</externalId>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Fundraising Donor</label>
    <nameField>
        <label>Donor Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Fundraising Donors</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
