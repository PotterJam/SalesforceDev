    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks and categorizes fundraising channels and sources such as events, online giving, corporate partnerships, and direct mail.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Description__c</fullName>
        <description>Describes the purpose and details of this fundraising channel.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter a description for this fundraising channel.</inlineHelpText>
        <label>Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Indicates whether this fundraising channel is currently active.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current status of this fundraising channel.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>true</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <label>Inactive</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <description>Categorizes the fundraising channel by source type.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the type of fundraising channel.</inlineHelpText>
        <label>Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Events</fullName>
                    <default>false</default>
                    <label>Events</label>
                </value>
                <value>
                    <fullName>Online</fullName>
                    <default>false</default>
                    <label>Online</label>
                </value>
                <value>
                    <fullName>Corporate</fullName>
                    <default>false</default>
                    <label>Corporate</label>
                </value>
                <value>
                    <fullName>Direct Mail</fullName>
                    <default>false</default>
                    <label>Direct Mail</label>
                </value>
                <value>
                    <fullName>Grants</fullName>
                    <default>false</default>
                    <label>Grants</label>
                </value>
                <value>
                    <fullName>Major Gifts</fullName>
                    <default>false</default>
                    <label>Major Gifts</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Fundraising Channel</label>
    <nameField>
        <displayFormat>FC-{00000}</displayFormat>
        <label>Fundraising Channel Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Fundraising Channels</pluralLabel>
