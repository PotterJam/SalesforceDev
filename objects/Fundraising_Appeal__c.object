    <deploymentStatus>Deployed</deploymentStatus>
    <description>A specific fundraising ask or outreach effort within a campaign, representing a particular channel or communication to solicit donations.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Campaign__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The fundraising campaign this appeal belongs to.</description>
        <externalId>false</externalId>
        <label>Campaign</label>
        <referenceTo>Fundraising_Campaign__c</referenceTo>
        <relationshipLabel>Appeals</relationshipLabel>
        <relationshipName>Appeals</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Ask_Amount__c</fullName>
        <description>The suggested donation amount requested in this appeal.</description>
        <externalId>false</externalId>
        <label>Ask Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Send_Date__c</fullName>
        <description>The date when the appeal was or will be sent to donors.</description>
        <externalId>false</externalId>
        <label>Send Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Channel__c</fullName>
        <description>The communication channel used to deliver this appeal to donors.</description>
        <externalId>false</externalId>
        <label>Channel</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Direct Mail</fullName>
                    <default>false</default>
                    <label>Direct Mail</label>
                </value>
                <value>
                    <fullName>Email</fullName>
                    <default>false</default>
                    <label>Email</label>
                </value>
                <value>
                    <fullName>Event</fullName>
                    <default>false</default>
                    <label>Event</label>
                </value>
                <value>
                    <fullName>Phone</fullName>
                    <default>false</default>
                    <label>Phone</label>
                </value>
                <value>
                    <fullName>Digital</fullName>
                    <default>false</default>
                    <label>Digital</label>
                </value>
                <value>
                    <fullName>Personal Visit</fullName>
                    <default>false</default>
                    <label>Personal Visit</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Response_Count__c</fullName>
        <description>The number of donor responses received for this appeal.</description>
        <externalId>false</externalId>
        <label>Response Count</label>
        <precision>8</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Raised__c</fullName>
        <description>The total amount of donations raised through this appeal.</description>
        <externalId>false</externalId>
        <label>Total Raised</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current status of the appeal.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Planning</fullName>
                    <default>true</default>
                    <label>Planning</label>
                </value>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Fundraising Appeal</label>
    <nameField>
        <label>Appeal Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Fundraising Appeals</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
