    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks financing and loan applications associated with a car deal, including lender details, loan terms, interest rates, and application status.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Car_Deal__c</fullName>
        <description>The car deal this financing application is associated with.</description>
        <externalId>false</externalId>
        <inlineHelpText>The parent car deal for this financing record.</inlineHelpText>
        <label>Car Deal</label>
        <referenceTo>Car_Deal__c</referenceTo>
        <relationshipLabel>Financing</relationshipLabel>
        <relationshipName>Financing</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Lender__c</fullName>
        <description>The name of the financing institution or bank.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the lender or bank name.</inlineHelpText>
        <label>Lender</label>
        <length>255</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Loan_Amount__c</fullName>
        <description>The total loan amount being financed.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the total loan amount.</inlineHelpText>
        <label>Loan Amount</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Interest_Rate__c</fullName>
        <description>The annual interest rate (APR) for this financing.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the annual interest rate (APR).</inlineHelpText>
        <label>Interest Rate</label>
        <precision>5</precision>
        <scale>3</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Term_Months__c</fullName>
        <description>The loan term length in months.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the loan term in months (e.g. 36, 48, 60, 72).</inlineHelpText>
        <label>Term Months</label>
        <precision>3</precision>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Monthly_Payment__c</fullName>
        <description>The calculated or quoted monthly payment amount.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the monthly payment amount.</inlineHelpText>
        <label>Monthly Payment</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Application_Status__c</fullName>
        <description>The current status of the financing application.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current application status.</inlineHelpText>
        <label>Application Status</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Denied</fullName>
                    <default>false</default>
                    <label>Denied</label>
                </value>
                <value>
                    <fullName>Conditionally Approved</fullName>
                    <default>false</default>
                    <label>Conditionally Approved</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Application_Date__c</fullName>
        <description>The date the financing application was submitted.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date the application was submitted.</inlineHelpText>
        <label>Application Date</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Approval_Date__c</fullName>
        <description>The date the financing was approved by the lender.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date financing was approved.</inlineHelpText>
        <label>Approval Date</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Down_Payment__c</fullName>
        <description>The down payment amount applied to this financing arrangement.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the down payment for this financing.</inlineHelpText>
        <label>Down Payment</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Credit_Score_Used__c</fullName>
        <description>The actual credit score used for this financing application.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the credit score used for this application.</inlineHelpText>
        <label>Credit Score Used</label>
        <precision>3</precision>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Co_Signer_Name__c</fullName>
        <description>The name of a co-signer on the financing application, if applicable.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the co-signer's name, if applicable.</inlineHelpText>
        <label>Co-Signer Name</label>
        <length>255</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Finance_Type__c</fullName>
        <description>The type of financing arrangement for this deal.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the type of financing.</inlineHelpText>
        <label>Finance Type</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Loan</fullName>
                    <default>true</default>
                    <label>Loan</label>
                </value>
                <value>
                    <fullName>Lease</fullName>
                    <default>false</default>
                    <label>Lease</label>
                </value>
                <value>
                    <fullName>Cash</fullName>
                    <default>false</default>
                    <label>Cash</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Free-text notes about this financing arrangement.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any notes about this financing.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Financing</label>
    <nameField>
        <displayFormat>FIN-{00000}</displayFormat>
        <label>Financing Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Financing</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
