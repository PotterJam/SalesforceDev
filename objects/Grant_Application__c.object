    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks grant applications submitted to funders, including their progress through review stages.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Application_Title__c</fullName>
        <description>The title of the grant application as submitted.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the title of this grant application.</inlineHelpText>
        <label>Application Title</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The funding opportunity this application is for.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the opportunity being applied to.</inlineHelpText>
        <label>Opportunity</label>
        <referenceTo>Grant_Opportunity__c</referenceTo>
        <relationshipLabel>Grant Applications</relationshipLabel>
        <relationshipName>Grant_Applications</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Funder__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The funding organization this application is submitted to.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the funder for this application.</inlineHelpText>
        <label>Funder</label>
        <referenceTo>Grant_Funder__c</referenceTo>
        <relationshipLabel>Grant Applications</relationshipLabel>
        <relationshipName>Grant_Applications</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount_Requested__c</fullName>
        <description>The dollar amount requested in this application.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the total amount requested.</inlineHelpText>
        <label>Amount Requested</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Submission_Date__c</fullName>
        <description>The date this application was submitted to the funder.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date the application was submitted.</inlineHelpText>
        <label>Submission Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Stage__c</fullName>
        <description>The current stage of this application in the review process.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current stage of this application.</inlineHelpText>
        <label>Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Drafting</fullName>
                    <default>true</default>
                    <label>Drafting</label>
                </value>
                <value>
                    <fullName>In Review</fullName>
                    <default>false</default>
                    <label>In Review</label>
                </value>
                <value>
                    <fullName>Submitted</fullName>
                    <default>false</default>
                    <label>Submitted</label>
                </value>
                <value>
                    <fullName>Under Funder Review</fullName>
                    <default>false</default>
                    <label>Under Funder Review</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Denied</fullName>
                    <default>false</default>
                    <label>Denied</label>
                </value>
                <value>
                    <fullName>Withdrawn</fullName>
                    <default>false</default>
                    <label>Withdrawn</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Decision_Date__c</fullName>
        <description>The date the funder communicated their decision.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date the funder communicated their decision.</inlineHelpText>
        <label>Decision Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Project_Summary__c</fullName>
        <description>A brief summary of the proposed project.</description>
        <externalId>false</externalId>
        <inlineHelpText>Provide a brief summary of the proposed project.</inlineHelpText>
        <label>Project Summary</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Budget_Summary__c</fullName>
        <description>A high-level budget breakdown for the application.</description>
        <externalId>false</externalId>
        <inlineHelpText>Provide a high-level budget breakdown.</inlineHelpText>
        <label>Budget Summary</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Grant_Period_Start__c</fullName>
        <description>The proposed start date for the grant period.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the proposed project start date.</inlineHelpText>
        <label>Grant Period Start</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Grant_Period_End__c</fullName>
        <description>The proposed end date for the grant period.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the proposed project end date.</inlineHelpText>
        <label>Grant Period End</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Internal notes about this application.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any internal notes about this application.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Grant Application</label>
    <nameField>
        <displayFormat>GA-{00000}</displayFormat>
        <label>Grant Application Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Grant Applications</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
