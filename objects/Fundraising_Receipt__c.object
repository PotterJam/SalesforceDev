    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Records tax-deductible receipts issued to donors for fundraising gifts, including delivery tracking.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Gift__c</fullName>
        <description>The parent fundraising gift this receipt was issued for.</description>
        <externalId>false</externalId>
        <label>Gift</label>
        <referenceTo>Fundraising_Gift__c</referenceTo>
        <relationshipLabel>Receipts</relationshipLabel>
        <relationshipName>Receipts</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Receipt_Number__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Unique receipt reference number for tax and audit purposes.</description>
        <externalId>true</externalId>
        <label>Receipt Number</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Receipt_Date__c</fullName>
        <description>The date this receipt was issued.</description>
        <externalId>false</externalId>
        <label>Receipt Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Receipt_Amount__c</fullName>
        <description>The tax-deductible amount shown on the receipt.</description>
        <externalId>false</externalId>
        <label>Receipt Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Donor_Name__c</fullName>
        <description>The donor name as it should appear on the receipt.</description>
        <externalId>false</externalId>
        <label>Donor Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Donor_Address__c</fullName>
        <description>The mailing address for receipt delivery.</description>
        <externalId>false</externalId>
        <label>Donor Address</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Sent_Date__c</fullName>
        <description>The date this receipt was sent to the donor.</description>
        <externalId>false</externalId>
        <label>Sent Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Delivery_Method__c</fullName>
        <description>How this receipt was or will be delivered to the donor.</description>
        <externalId>false</externalId>
        <label>Delivery Method</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Email</fullName>
                    <default>false</default>
                    <label>Email</label>
                </value>
                <value>
                    <fullName>Mail</fullName>
                    <default>false</default>
                    <label>Mail</label>
                </value>
                <value>
                    <fullName>Both</fullName>
                    <default>false</default>
                    <label>Both</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Is_Void__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether this receipt has been voided.</description>
        <externalId>false</externalId>
        <label>Void</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Fundraising Receipt</label>
    <nameField>
        <displayFormat>RCT-{00000}</displayFormat>
        <label>Receipt Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Fundraising Receipts</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
