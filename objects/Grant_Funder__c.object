    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks funding organizations and foundations that provide grant opportunities.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Funder_Name__c</fullName>
        <description>The name of the funding organization or foundation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the full legal name of the funding organization.</inlineHelpText>
        <label>Funder Name</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <description>The classification of the funding organization.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the type of funding organization.</inlineHelpText>
        <label>Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Foundation</fullName>
                    <default>false</default>
                    <label>Foundation</label>
                </value>
                <value>
                    <fullName>Government</fullName>
                    <default>false</default>
                    <label>Government</label>
                </value>
                <value>
                    <fullName>Corporate</fullName>
                    <default>false</default>
                    <label>Corporate</label>
                </value>
                <value>
                    <fullName>Individual</fullName>
                    <default>false</default>
                    <label>Individual</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Website__c</fullName>
        <description>The website of the funding organization.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the funder's website URL.</inlineHelpText>
        <label>Website</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Contact_Name__c</fullName>
        <description>The primary contact person at the funding organization.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the name of the primary contact at this funder.</inlineHelpText>
        <label>Contact Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contact_Email__c</fullName>
        <description>The email address for the primary contact at the funding organization.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the email address for the primary contact.</inlineHelpText>
        <label>Contact Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Contact_Phone__c</fullName>
        <description>The phone number for the primary contact at the funding organization.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the phone number for the primary contact.</inlineHelpText>
        <label>Contact Phone</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Phone</type>
    </fields>
    <fields>
        <fullName>Focus_Areas__c</fullName>
        <description>The funding priorities, focus areas, and interests of this funder.</description>
        <externalId>false</externalId>
        <inlineHelpText>Describe the funder's priority areas and interests.</inlineHelpText>
        <label>Focus Areas</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Average_Grant_Size__c</fullName>
        <description>The typical grant amount awarded by this funder.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the typical grant amount this funder awards.</inlineHelpText>
        <label>Average Grant Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Application_Cycle__c</fullName>
        <description>How frequently this funder accepts new applications.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select how often this funder accepts applications.</inlineHelpText>
        <label>Application Cycle</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Rolling</fullName>
                    <default>false</default>
                    <label>Rolling</label>
                </value>
                <value>
                    <fullName>Annual</fullName>
                    <default>false</default>
                    <label>Annual</label>
                </value>
                <value>
                    <fullName>Biannual</fullName>
                    <default>false</default>
                    <label>Biannual</label>
                </value>
                <value>
                    <fullName>Quarterly</fullName>
                    <default>false</default>
                    <label>Quarterly</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Internal notes about this funding organization.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any internal notes about this funder.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current engagement status with this funder.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current status of this funder relationship.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>true</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Inactive</fullName>
                    <default>false</default>
                    <label>Inactive</label>
                </value>
                <value>
                    <fullName>Prospect</fullName>
                    <default>false</default>
                    <label>Prospect</label>
                </value>
                <value>
                    <fullName>Do Not Apply</fullName>
                    <default>false</default>
                    <label>Do Not Apply</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Grant Funder</label>
    <nameField>
        <displayFormat>GF-{00000}</displayFormat>
        <label>Grant Funder Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Grant Funders</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
