    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks individual payment disbursements received for grant awards.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Award__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The grant award this payment is associated with.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the parent grant award.</inlineHelpText>
        <label>Award</label>
        <referenceTo>Grant_Award__c</referenceTo>
        <relationshipLabel>Grant Payments</relationshipLabel>
        <relationshipName>Grant_Payments</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount__c</fullName>
        <description>The payment amount received or expected.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the payment amount.</inlineHelpText>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Payment_Date__c</fullName>
        <description>The date the payment was received.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date the payment was received.</inlineHelpText>
        <label>Payment Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Payment_Type__c</fullName>
        <description>The type of payment disbursement.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the type of payment.</inlineHelpText>
        <label>Payment Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Advance</fullName>
                    <default>false</default>
                    <label>Advance</label>
                </value>
                <value>
                    <fullName>Reimbursement</fullName>
                    <default>false</default>
                    <label>Reimbursement</label>
                </value>
                <value>
                    <fullName>Milestone-Based</fullName>
                    <default>false</default>
                    <label>Milestone-Based</label>
                </value>
                <value>
                    <fullName>Final</fullName>
                    <default>false</default>
                    <label>Final</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Reference_Number__c</fullName>
        <description>The check, wire, or transfer reference number.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the check/wire/transfer reference number.</inlineHelpText>
        <label>Reference Number</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current status of this payment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current status of this payment.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Expected</fullName>
                    <default>true</default>
                    <label>Expected</label>
                </value>
                <value>
                    <fullName>Received</fullName>
                    <default>false</default>
                    <label>Received</label>
                </value>
                <value>
                    <fullName>Overdue</fullName>
                    <default>false</default>
                    <label>Overdue</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Expected_Date__c</fullName>
        <description>The date this payment is expected to be received.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the expected payment date.</inlineHelpText>
        <label>Expected Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Internal notes about this payment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any internal notes about this payment.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Grant Payment</label>
    <nameField>
        <displayFormat>GP-{00000}</displayFormat>
        <label>Grant Payment Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Grant Payments</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
