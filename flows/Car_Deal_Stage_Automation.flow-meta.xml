        </assignmentItems>
    </assignments>
    <assignments>
        <name>Fault_Handler_Available</name>
        <label>Capture Fault Vehicle Available</label>
        <locationX>396</locationX>
        <locationY>671</locationY>
        <assignmentItems>
            <assignToReference>FaultMessage</assignToReference>
