    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents an individual user in a round-robin Lead assignment pool, tracking their availability, position in the rotation, and assignment history.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Assignment_Count__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Running total of Leads assigned to this pool member via round-robin.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total number of Leads assigned to this member.</inlineHelpText>
        <label>Assignment Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates whether this member is currently available to receive Lead assignments in the round-robin rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily remove this member from the assignment rotation.</inlineHelpText>
        <label>Is Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Last_Assigned_Date__c</fullName>
        <description>Date and time when a Lead was last assigned to this pool member via round-robin.</description>
        <externalId>false</externalId>
        <inlineHelpText>When this member was last assigned a Lead.</inlineHelpText>
        <label>Last Assigned Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Round_Robin_Config__c</fullName>
        <description>The parent round-robin configuration pool this member belongs to.</description>
        <externalId>false</externalId>
        <label>Round Robin Config</label>
        <referenceTo>Round_Robin_Config__c</referenceTo>
        <relationshipLabel>Round Robin Members</relationshipLabel>
        <relationshipName>Round_Robin_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Determines the position of this member in the round-robin rotation sequence.</description>
        <externalId>false</externalId>
        <inlineHelpText>Lower numbers are assigned Leads first when multiple members have the same last assigned date.</inlineHelpText>
        <label>Sort Order</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Salesforce user who will receive Lead assignments as part of this round-robin pool.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user to include in this round-robin assignment pool.</inlineHelpText>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Round_Robin_Members</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Round Robin Member</label>
    <nameField>
        <displayFormat>RRM-{00000}</displayFormat>
        <label>Round Robin Member Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
