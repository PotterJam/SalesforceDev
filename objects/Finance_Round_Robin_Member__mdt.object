<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Stores the list of users participating in the Finance Queue round-robin assignment rotation. Each record represents one user with a sequence number determining their position in the rotation.</description>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this user is included in the round-robin rotation. Deactivate to temporarily remove a user without deleting the record.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sequence__c</fullName>
        <description>Determines the position of this user in the round-robin rotation. Lower numbers are assigned first.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Sequence</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <description>The 18-character Salesforce User ID of the round-robin participant.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>User</label>
        <length>18</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Finance Round Robin Member</label>
    <pluralLabel>Finance Round Robin Members</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
