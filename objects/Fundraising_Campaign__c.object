    <fields>
        <fullName>CloseDate__c</fullName>
        <description>Target date by which the funding round is expected to close.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the expected close date for this funding round.</inlineHelpText>
        <label>Close Date</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Overview and notes for the fundraising campaign.</description>
        <externalId>false</externalId>
        <inlineHelpText>Describe the goals, context, and key details of this funding round.</inlineHelpText>
        <label>Description</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>InvestorCount__c</fullName>
        <description>Target number of investors to bring into this funding round.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the target number of investors for this round.</inlineHelpText>
        <label>Investor Count</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>LeadInvestor__c</fullName>
        <description>Name of the lead investor or investment firm for this funding round.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the name of the lead investor or firm.</inlineHelpText>
        <label>Lead Investor</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <length>255</length>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RaisedAmount__c</fullName>
        <description>Amount of funding raised to date in this campaign.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the total amount raised so far in this round.</inlineHelpText>
        <label>Raised Amount</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
        <precision>18</precision>
        <scale>2</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>StartDate__c</fullName>
        <description>Date on which the fundraising campaign was opened.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date this funding round was opened.</inlineHelpText>
        <label>Start Date</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Current status of the fundraising campaign.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current status of this funding round.</inlineHelpText>
        <label>Status</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Planning</fullName>
                    <default>true</default>
                    <label>Planning</label>
                </value>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Closed</fullName>
                    <default>false</default>
                    <label>Closed</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
