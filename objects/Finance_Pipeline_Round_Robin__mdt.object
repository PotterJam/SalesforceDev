<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Stores the roster of finance pipeline team members for round-robin Lead assignment. Each record represents one team member in the rotation.</description>
    <label>Finance Pipeline Round Robin</label>
    <pluralLabel>Finance Pipeline Round Robins</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>User_Id__c</fullName>
        <description>The 18-character Salesforce User ID of the team member to assign Leads to.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Enter the 18-character User ID for this team member.</inlineHelpText>
        <label>User Id</label>
        <length>18</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sequence__c</fullName>
        <description>The position of this team member in the round-robin rotation. Lower numbers are assigned first.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Enter the sequence number for this team member in the rotation.</inlineHelpText>
        <label>Sequence</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Whether this team member is currently active in the round-robin rotation.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Uncheck to temporarily remove this member from the rotation without deleting the record.</inlineHelpText>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
</CustomObject>
