    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores the pool of users eligible for round-robin assignment on Finance Queue records</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>User__c</fullName>
        <description>The user participating in the finance queue round-robin assignment rotation</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user to include in the round-robin rotation.</inlineHelpText>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Finance_Round_Robin_Members</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
        <deleteConstraint>SetNull</deleteConstraint>
    </fields>
    <fields>
        <fullName>Sequence__c</fullName>
        <description>Order position for initial rotation sequencing when no assignments have been made</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the sequence number to define this member's position in the rotation.</inlineHelpText>
        <label>Sequence</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Active__c</fullName>
        <description>Whether this member is currently active in the round-robin rotation</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily remove this member from the rotation without deleting the record.</inlineHelpText>
        <label>Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
        <defaultValue>true</defaultValue>
    </fields>
    <fields>
        <fullName>Last_Assigned_Date__c</fullName>
        <description>Timestamp of when this member was last assigned a Finance Queue record</description>
        <externalId>false</externalId>
        <inlineHelpText>Automatically updated when a Finance Queue record is assigned to this member.</inlineHelpText>
        <label>Last Assigned Date</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
        <required>false</required>
    </fields>
    <label>Finance Round Robin Member</label>
    <nameField>
        <displayFormat>FRR-{00000}</displayFormat>
        <label>Finance Round Robin Member Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Finance Round Robin Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
