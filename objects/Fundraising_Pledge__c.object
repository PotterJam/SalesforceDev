    <deploymentStatus>Deployed</deploymentStatus>
    <description>A commitment from a donor to donate a specified amount over time, typically fulfilled through scheduled installment payments.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Donor__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The donor who made this pledge commitment.</description>
        <externalId>false</externalId>
        <label>Donor</label>
        <referenceTo>Fundraising_Donor__c</referenceTo>
        <relationshipLabel>Pledges</relationshipLabel>
        <relationshipName>Pledges</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Campaign__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The fundraising campaign this pledge is associated with.</description>
        <externalId>false</externalId>
        <label>Campaign</label>
        <referenceTo>Fundraising_Campaign__c</referenceTo>
        <relationshipLabel>Pledges</relationshipLabel>
        <relationshipName>Pledges</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Total_Amount__c</fullName>
        <description>The total amount the donor has pledged to give.</description>
        <externalId>false</externalId>
        <label>Total Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Start_Date__c</fullName>
        <description>The date when pledge payments are expected to begin.</description>
        <externalId>false</externalId>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
        <description>The date by which all pledge payments should be completed.</description>
        <externalId>false</externalId>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Installment_Frequency__c</fullName>
        <description>How often installment payments are expected from the donor.</description>
        <externalId>false</externalId>
        <label>Installment Frequency</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>One-time</fullName>
                    <default>false</default>
                    <label>One-time</label>
                </value>
                <value>
                    <fullName>Weekly</fullName>
                    <default>false</default>
                    <label>Weekly</label>
                </value>
                <value>
                    <fullName>Monthly</fullName>
                    <default>true</default>
                    <label>Monthly</label>
                </value>
                <value>
                    <fullName>Quarterly</fullName>
                    <default>false</default>
                    <label>Quarterly</label>
                </value>
                <value>
                    <fullName>Semi-Annual</fullName>
                    <default>false</default>
                    <label>Semi-Annual</label>
                </value>
                <value>
                    <fullName>Annual</fullName>
                    <default>false</default>
                    <label>Annual</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Installment_Amount__c</fullName>
        <description>The expected amount for each installment payment.</description>
        <externalId>false</externalId>
        <label>Installment Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Amount_Paid__c</fullName>
        <description>The total amount paid against this pledge, automatically calculated from received payments.</description>
        <externalId>false</externalId>
        <label>Amount Paid</label>
        <summarizedField>Fundraising_Payment__c.Amount__c</summarizedField>
        <summaryFilterItems>
            <field>Fundraising_Payment__c.Status__c</field>
            <operation>equals</operation>
            <value>Received</value>
        </summaryFilterItems>
        <summaryForeignKey>Fundraising_Payment__c.Pledge__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Balance_Remaining__c</fullName>
        <description>The remaining balance on this pledge, calculated as Total Amount minus Amount Paid.</description>
        <externalId>false</externalId>
        <formula>Total_Amount__c - Amount_Paid__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Balance Remaining</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current status of the pledge.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Active</fullName>
                    <default>true</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Fulfilled</fullName>
                    <default>false</default>
                    <label>Fulfilled</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
                <value>
                    <fullName>Delinquent</fullName>
                    <default>false</default>
                    <label>Delinquent</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Additional notes about this pledge, such as donor preferences or special conditions.</description>
        <externalId>false</externalId>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <label>Fundraising Pledge</label>
    <nameField>
        <label>Pledge Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Fundraising Pledges</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Pledge_End_Date_After_Start</fullName>
        <active>true</active>
        <description>Ensures the pledge end date is not before the start date.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(End_Date__c)), NOT(ISBLANK(Start_Date__c)), End_Date__c &lt; Start_Date__c)</errorConditionFormula>
        <errorDisplayField>End_Date__c</errorDisplayField>
        <errorMessage>End Date must be on or after Start Date.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
