    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks round-robin assignment state for Finance Transaction records. Each record represents a queue whose members are cycled through when assigning new Finance Transactions.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Queue_Id__c</fullName>
        <description>The 18-character Salesforce Group ID of the Queue whose members participate in round-robin assignment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the 18-character ID of the Salesforce Queue to use for round-robin assignment.</inlineHelpText>
        <label>Queue Id</label>
        <length>18</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Current_Index__c</fullName>
        <defaultValueFormula>0</defaultValueFormula>
        <description>The current position in the round-robin rotation. Incremented each time a Finance Transaction is assigned.</description>
        <externalId>false</externalId>
        <inlineHelpText>Current rotation position. Automatically updated by the round-robin assignment flow.</inlineHelpText>
        <label>Current Index</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Finance Round Robin Tracker</label>
    <nameField>
        <displayFormat>RR-{00000}</displayFormat>
        <label>Tracker Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Finance Round Robin Trackers</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
