    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks round robin assignment state and position for the finance pipeline, enabling automated sequential distribution of records to assignees.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Current_Assignee__c</fullName>
        <description>The user currently assigned in the round robin rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the current assignee for this record.</inlineHelpText>
        <label>Current Assignee</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether this round robin entry is currently active and participating in assignment rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Check this box to activate this round robin entry.</inlineHelpText>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Last_Assigned_Date__c</fullName>
        <description>The date and time when the last assignment was made through this round robin entry.</description>
        <externalId>false</externalId>
        <inlineHelpText>Shows when the last assignment was made.</inlineHelpText>
        <label>Last Assigned Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Next_Assignee__c</fullName>
        <description>The next user to be assigned in the round robin rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the next assignee for this record.</inlineHelpText>
        <label>Next Assignee</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Round_Robin_Position__c</fullName>
        <description>The current position index in the round robin rotation sequence.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the current position in the rotation.</inlineHelpText>
        <label>Round Robin Position</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Finance Pipeline Round Robin</label>
    <nameField>
        <displayFormat>FPR-{00000}</displayFormat>
        <label>Finance Pipeline Round Robin Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Finance Pipeline Round Robins</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
