    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Is_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates whether this agent is currently available to receive round-robin Lead assignments.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily remove this agent from the assignment rotation.</inlineHelpText>
        <label>Is Available</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Last_Assigned_Date__c</fullName>
        <description>The date and time this agent was last assigned a Lead via round-robin.</description>
        <externalId>false</externalId>
        <inlineHelpText>Automatically updated when a Lead is assigned to this agent.</inlineHelpText>
        <label>Last Assigned Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Determines the position of this agent in the round-robin rotation. Lower numbers are assigned first.</description>
        <externalId>false</externalId>
        <inlineHelpText>Set the position in the assignment rotation (1 = first).</inlineHelpText>
        <label>Sort Order</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The user who will be assigned Leads through the round-robin process.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user to include in the round-robin assignment pool.</inlineHelpText>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Round_Robin_Agents</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Round Robin Agent</label>
    <nameField>
        <displayFormat>RRA-{00000}</displayFormat>
        <label>Round Robin Agent Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Agents</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
