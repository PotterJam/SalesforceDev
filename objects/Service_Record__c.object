        <inlineHelpText>Enter the mileage at the time of service.</inlineHelpText>
        <label>Mileage At Service</label>
        <precision>10</precision>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
