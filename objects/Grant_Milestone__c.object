    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks deliverables and milestones required within an awarded grant.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Milestone_Title__c</fullName>
        <description>The title or description of this milestone deliverable.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the title of this milestone.</inlineHelpText>
        <label>Milestone Title</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Award__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The grant award this milestone belongs to.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the parent grant award.</inlineHelpText>
        <label>Award</label>
        <referenceTo>Grant_Award__c</referenceTo>
        <relationshipLabel>Grant Milestones</relationshipLabel>
        <relationshipName>Grant_Milestones</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Due_Date__c</fullName>
        <description>The date this milestone is due.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the due date for this milestone.</inlineHelpText>
        <label>Due Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Completion_Date__c</fullName>
        <description>The date this milestone was actually completed.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date this milestone was completed.</inlineHelpText>
        <label>Completion Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The current status of this milestone.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current status of this milestone.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Started</fullName>
                    <default>true</default>
                    <label>Not Started</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Overdue</fullName>
                    <default>false</default>
                    <label>Overdue</label>
                </value>
                <value>
                    <fullName>Waived</fullName>
                    <default>false</default>
                    <label>Waived</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Detailed description of what this milestone deliverable entails.</description>
        <externalId>false</externalId>
        <inlineHelpText>Describe what this milestone deliverable entails.</inlineHelpText>
        <label>Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Internal notes about this milestone.</description>
        <externalId>false</externalId>
        <inlineHelpText>Add any internal notes about this milestone.</inlineHelpText>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
