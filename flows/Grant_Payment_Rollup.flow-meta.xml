<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>When a Grant Payment is created, updated, or deleted, recalculates Amount_Received__c and Amount_Remaining__c on the parent Grant Award.</description>
    <environments>Default</environments>
    <interviewLabel>Grant Payment Rollup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Grant Payment Rollup</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Check_Award_Exists</name>
        <label>Check Award Exists</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>No Award</defaultConnectorLabel>
        <rules>
            <name>Has_Award</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Award__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Received_Payments</targetReference>
            </connector>
            <label>Has Award</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Received_Payments</name>
        <label>Get Received Payments</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Get_Award_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Award__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Award__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Received</stringValue>
            </value>
        </filters>
        <object>Grant_Payment__c</object>
        <outputAssignments>
            <assignToReference>varTotalReceived</assignToReference>
            <field>Amount__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Award_Record</name>
        <label>Get Award Record</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <connector>
            <targetReference>Update_Award_Amounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Award__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Grant_Award__c</object>
        <outputReference>varAwardRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Amount_Awarded__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Award_Amounts</name>
        <label>Update Award Amounts</label>
        <locationX>50</locationX>
        <locationY>671</locationY>
        <faultConnector>
            <targetReference>Fault_Handler</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Award__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount_Received__c</field>
            <value>
                <elementReference>varTotalReceived</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount_Remaining__c</field>
            <value>
                <elementReference>formulaAmountRemaining</elementReference>
            </value>
        </inputAssignments>
        <object>Grant_Award__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Fault_Handler</name>
        <label>Fault Handler</label>
        <locationX>50</locationX>
        <locationY>791</locationY>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <stringValue>Error: Could not automatically update award payment totals.</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <formulas>
        <name>formulaAmountRemaining</name>
        <dataType>Currency</dataType>
        <expression>{!varAwardRecord.Amount_Awarded__c} - {!varTotalReceived}</expression>
        <scale>2</scale>
    </formulas>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Award_Exists</targetReference>
        </connector>
        <object>Grant_Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varTotalReceived</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varAwardRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Grant_Award__c</objectType>
    </variables>
</Flow>
