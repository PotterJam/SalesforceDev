    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents a round robin assignment queue for distributing Leads sequentially among team members based on eligibility criteria.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether this queue is actively used for Lead round robin assignment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Check this box to make this queue the active round robin queue for Lead assignment.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>A description of the purpose and scope of this round robin queue.</description>
        <externalId>false</externalId>
        <inlineHelpText>Describe the purpose of this queue (e.g. which team or territory it serves).</inlineHelpText>
        <label>Description</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Last_Assigned_Index__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Tracks the Sort Order value of the last member who was assigned a Lead. Used internally by the round robin algorithm to determine the next assignee.</description>
        <externalId>false</externalId>
        <inlineHelpText>The sort order position of the last assigned member. Managed automatically by the system.</inlineHelpText>
        <label>Last Assigned Index</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Round Robin Queue</label>
    <nameField>
        <displayFormat>RRQ-{00000}</displayFormat>
        <label>Round Robin Queue Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Queues</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
