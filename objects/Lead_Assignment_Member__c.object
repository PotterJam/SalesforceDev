    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents a user who participates in a Lead Assignment Pool. Tracks their position in the rotation, availability status, and maximum lead capacity.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Assignment_Pool__c</fullName>
        <description>The assignment pool this member belongs to. Deleting the pool will cascade-delete all members.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the assignment pool this member belongs to.</inlineHelpText>
        <label>Assignment Pool</label>
        <referenceTo>Lead_Assignment_Pool__c</referenceTo>
        <relationshipLabel>Assignment Members</relationshipLabel>
        <relationshipName>Assignment_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The Salesforce user who will receive Lead assignments from this pool.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user to include in this assignment pool.</inlineHelpText>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Lead_Assignment_Members</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Determines the position of this member in the round-robin rotation. Lower numbers are assigned first.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the position in the rotation order (1 = first in line).</inlineHelpText>
        <label>Sort Order</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this member is eligible to receive Lead assignments. Uncheck when the user is out of office or temporarily unavailable.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to skip this member during round-robin assignment (e.g. out of office).</inlineHelpText>
        <label>Is Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Max_Open_Leads__c</fullName>
        <defaultValue>50</defaultValue>
        <description>The maximum number of open Leads this member can own before being skipped in the rotation. Provides automatic capacity-based gating.</description>
        <externalId>false</externalId>
        <inlineHelpText>Maximum number of open Leads this user can own before being skipped.</inlineHelpText>
        <label>Max Open Leads</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Lead Assignment Member</label>
    <nameField>
        <displayFormat>LAM-{00000}</displayFormat>
        <label>Lead Assignment Member Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Lead Assignment Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
