    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Defines a qualification criterion that a Lead must satisfy to enter the round-robin assignment. All active criteria must be met (AND logic).</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this criterion is evaluated. Inactive criteria are ignored during qualification.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to disable this criterion without deleting it.</inlineHelpText>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Config__c</fullName>
        <description>The parent round-robin configuration this criterion belongs to.</description>
        <externalId>false</externalId>
        <label>Config</label>
        <referenceTo>Lead_Round_Robin_Config__c</referenceTo>
        <relationshipLabel>Round Robin Criteria</relationshipLabel>
        <relationshipName>Round_Robin_Criteria</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Field_API_Name__c</fullName>
        <description>The API name of the Lead field to evaluate (e.g. LeadSource, Country, Industry).</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the API name of the Lead field to check.</inlineHelpText>
        <label>Field API Name</label>
        <length>100</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Operator__c</fullName>
        <description>The comparison operator used to evaluate the Lead field value against the expected value.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select how to compare the field value.</inlineHelpText>
        <label>Operator</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Equals</fullName>
                    <default>true</default>
                    <label>Equals</label>
                </value>
                <value>
                    <fullName>Not Equals</fullName>
                    <default>false</default>
                    <label>Not Equals</label>
                </value>
                <value>
                    <fullName>Contains</fullName>
                    <default>false</default>
                    <label>Contains</label>
                </value>
                <value>
                    <fullName>Not Contains</fullName>
                    <default>false</default>
                    <label>Not Contains</label>
                </value>
                <value>
                    <fullName>Is Blank</fullName>
                    <default>false</default>
                    <label>Is Blank</label>
                </value>
                <value>
                    <fullName>Is Not Blank</fullName>
                    <default>false</default>
                    <label>Is Not Blank</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Value__c</fullName>
        <description>The expected value to compare against. For multi-value matching, use comma-separated values. Not required for Is Blank / Is Not Blank operators.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the value to match. Use commas for multiple values.</inlineHelpText>
        <label>Value</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Lead Round Robin Criteria</label>
    <nameField>
        <label>Criteria Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Lead Round Robin Criteria</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
