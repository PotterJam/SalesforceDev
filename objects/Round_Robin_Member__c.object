    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents an individual user who participates in a round robin queue for Lead assignment. Controls their position in the rotation and availability status.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Round_Robin_Queue__c</fullName>
        <description>The round robin queue this member belongs to. Deleting the queue removes all its members.</description>
        <externalId>false</externalId>
        <label>Round Robin Queue</label>
        <referenceTo>Round_Robin_Queue__c</referenceTo>
        <relationshipLabel>Round Robin Members</relationshipLabel>
        <relationshipName>Round_Robin_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Salesforce user who will receive Lead assignments from this queue position.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user to include in the round robin rotation.</inlineHelpText>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Round Robin Memberships</relationshipLabel>
        <relationshipName>Round_Robin_Memberships</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Determines this member's position in the round robin sequence. Lower values are assigned first.</description>
        <externalId>false</externalId>
        <inlineHelpText>The position of this member in the assignment rotation. Lower numbers are assigned first.</inlineHelpText>
        <label>Sort Order</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this member is eligible to receive Lead assignments. Uncheck to temporarily exclude a member (e.g. on leave).</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily remove this member from the rotation without deleting them.</inlineHelpText>
        <label>Is Available</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Assignment_Count__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Running total of Leads assigned to this member via the round robin system. Updated automatically on each assignment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total number of Leads assigned to this member. Updated automatically.</inlineHelpText>
        <label>Assignment Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Round Robin Member</label>
    <nameField>
        <displayFormat>RRM-{00000}</displayFormat>
        <label>Round Robin Member Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
