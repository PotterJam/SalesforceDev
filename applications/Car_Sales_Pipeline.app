<?xml version="1.0" encoding="UTF-8"?>
<CustomApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <brand>
        <headerColor>#1B5E20</headerColor>
        <shouldOverrideOrgTheme>false</shouldOverrideOrgTheme>
    </brand>
    <description>Car Sales Pipeline application for managing vehicle inventory, customers, deals, trade-ins, test drives, financing, and after-sale service.</description>
    <formFactors>Large</formFactors>
    <isNavAutoTempTabsDisabled>false</isNavAutoTempTabsDisabled>
    <isNavPersonalizationDisabled>false</isNavPersonalizationDisabled>
    <label>Car Sales Pipeline</label>
    <navType>Standard</navType>
    <tabs>standard-home</tabs>
    <tabs>Vehicle__c</tabs>
    <tabs>Customer__c</tabs>
    <tabs>Car_Deal__c</tabs>
    <tabs>Trade_In__c</tabs>
    <tabs>Test_Drive__c</tabs>
    <tabs>Financing__c</tabs>
    <tabs>Service_Record__c</tabs>
    <tabs>standard-report</tabs>
    <tabs>standard-Dashboard</tabs>
    <uiType>Lightning</uiType>
</CustomApplication>
