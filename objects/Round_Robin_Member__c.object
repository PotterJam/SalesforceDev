    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents a Queue participating in a round robin rotation group. Tracks assignment statistics, eligibility, and capacity for the Queue.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this member Queue is eligible to receive Lead assignments in the rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>When checked, this Queue is eligible to receive Leads in the rotation.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Assignment_Count__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Running total of Leads assigned to this Queue through the round robin rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total number of Leads assigned to this Queue.</inlineHelpText>
        <label>Assignment Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Current_Load__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Current number of open Leads assigned to this Queue. Used for capacity gating.</description>
        <externalId>false</externalId>
        <inlineHelpText>Current open Lead count for this Queue. When this equals or exceeds Max Capacity, the Queue is skipped.</inlineHelpText>
        <label>Current Load</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Last_Assigned_Date__c</fullName>
        <description>Records when a Lead was last assigned to this Queue through the round robin rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Date and time of the last Lead assignment to this Queue.</inlineHelpText>
        <label>Last Assigned Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Max_Capacity__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Maximum number of open Leads this Queue can hold before being skipped in rotation. A value of 0 means unlimited capacity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Maximum open Leads allowed. Set to 0 for unlimited capacity.</inlineHelpText>
        <label>Max Capacity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Queue_Id__c</fullName>
        <description>The 18-character Salesforce Group ID of the Queue that receives Lead assignments.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the 18-character ID of the Queue.</inlineHelpText>
        <label>Queue Id</label>
        <length>18</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Queue_Name__c</fullName>
        <description>Display name of the Queue for easy identification in the round robin configuration.</description>
        <externalId>false</externalId>
        <inlineHelpText>The display name of the Queue.</inlineHelpText>
        <label>Queue Name</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Round_Robin_Group__c</fullName>
        <description>The parent round robin group this member belongs to.</description>
        <externalId>false</externalId>
        <label>Round Robin Group</label>
        <referenceTo>Round_Robin_Group__c</referenceTo>
        <relationshipLabel>Round Robin Members</relationshipLabel>
        <relationshipName>Round_Robin_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Determines the position of this Queue in the round robin rotation sequence. Lower numbers are assigned first.</description>
        <externalId>false</externalId>
        <inlineHelpText>Position in the rotation. Lower numbers are assigned first.</inlineHelpText>
        <label>Sort Order</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Round Robin Member</label>
    <nameField>
        <displayFormat>RRM-{00000}</displayFormat>
        <label>Round Robin Member Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
