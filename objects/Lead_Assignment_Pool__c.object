    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Defines a named round-robin assignment pool for distributing Leads among a group of users. Stores the rotation pointer and fallback owner configuration.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Pool_Name__c</fullName>
        <description>The friendly display name for this assignment pool, used in the admin UI and logs.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter a descriptive name for this assignment pool (e.g. EMEA Sales, NA Enterprise).</inlineHelpText>
        <label>Pool Name</label>
        <length>80</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this pool is eligible for Lead assignment. Inactive pools are skipped during round-robin processing.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily disable this pool without deleting it.</inlineHelpText>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Last_Assigned_Index__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Tracks the sort order position of the last member who was assigned a Lead. Used by the round-robin algorithm to determine the next assignee.</description>
        <externalId>false</externalId>
        <inlineHelpText>The sort order index of the last assigned member. Managed automatically by the system.</inlineHelpText>
        <label>Last Assigned Index</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Fallback_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The user who receives Lead assignment when no pool members are available or all are at capacity. Acts as a safety net to prevent unassigned Leads.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select a fallback user who will receive Leads when no pool members are available.</inlineHelpText>
        <label>Fallback Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Lead_Assignment_Pools</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Lead Assignment Pool</label>
    <nameField>
        <displayFormat>LAP-{00000}</displayFormat>
        <label>Lead Assignment Pool Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Lead Assignment Pools</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
