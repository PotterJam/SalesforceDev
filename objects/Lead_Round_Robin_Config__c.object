    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores the active configuration for the Lead round-robin assignment engine including rotation state and activation status.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Read</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Controls whether the round-robin assignment engine is active. When unchecked, new Leads will not be assigned via round robin.</description>
        <externalId>false</externalId>
        <inlineHelpText>Check to enable round-robin Lead assignment.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Current_Index__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Tracks the zero-based position of the next queue to receive a Lead in the rotation. Automatically advanced by the assignment engine.</description>
        <externalId>false</externalId>
        <inlineHelpText>The current position in the queue rotation. Managed automatically.</inlineHelpText>
        <label>Current Index</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Administrative notes describing the purpose or scope of this round-robin configuration.</description>
        <externalId>false</externalId>
        <inlineHelpText>Optional description for this configuration.</inlineHelpText>
        <label>Description</label>
        <length>2000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <label>Lead Round Robin Config</label>
    <nameField>
        <displayFormat>RRC-{00000}</displayFormat>
        <label>Config Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Lead Round Robin Configs</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
