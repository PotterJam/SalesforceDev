    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks vehicle inventory for the car sales pipeline including make, model, year, pricing, condition, and availability status.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>VIN__c</fullName>
        <description>The 17-character Vehicle Identification Number uniquely identifying this vehicle.</description>
        <externalId>true</externalId>
        <inlineHelpText>Enter the 17-character VIN from the vehicle.</inlineHelpText>
        <label>VIN</label>
        <length>17</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Make__c</fullName>
        <description>The manufacturer or brand of the vehicle (e.g. Toyota, Ford, BMW).</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the vehicle manufacturer (e.g. Toyota, Ford).</inlineHelpText>
        <label>Make</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Model__c</fullName>
        <description>The specific model name of the vehicle (e.g. Camry, F-150, X5).</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the vehicle model name (e.g. Camry, F-150).</inlineHelpText>
        <label>Model</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Year__c</fullName>
        <description>The model year of the vehicle.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the 4-digit model year.</inlineHelpText>
        <label>Year</label>
        <precision>4</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Trim__c</fullName>
        <description>The trim level or package of the vehicle (e.g. SE, XLE, Limited).</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the trim level (e.g. SE, XLE, Limited).</inlineHelpText>
        <label>Trim</label>
        <length>100</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Exterior_Color__c</fullName>
        <description>The exterior paint color of the vehicle.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the exterior color.</inlineHelpText>
        <label>Exterior Color</label>
        <length>50</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Interior_Color__c</fullName>
        <description>The interior upholstery color of the vehicle.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the interior color.</inlineHelpText>
        <label>Interior Color</label>
        <length>50</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Mileage__c</fullName>
        <description>The current odometer reading of the vehicle in miles.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the current mileage from the odometer.</inlineHelpText>
        <label>Mileage</label>
        <precision>10</precision>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>List_Price__c</fullName>
        <description>The listed asking price for the vehicle on the lot.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the sticker/asking price.</inlineHelpText>
        <label>List Price</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Invoice_Cost__c</fullName>
        <description>The dealership's acquisition cost for this vehicle.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the invoice/acquisition cost to the dealership.</inlineHelpText>
        <label>Invoice Cost</label>
        <precision>18</precision>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Condition__c</fullName>
        <description>Whether the vehicle is new, certified pre-owned, or used.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the vehicle condition.</inlineHelpText>
        <label>Condition</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>true</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>Used - Certified</fullName>
                    <default>false</default>
                    <label>Used - Certified</label>
                </value>
                <value>
                    <fullName>Used</fullName>
                    <default>false</default>
                    <label>Used</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Inventory_Status__c</fullName>
        <description>The current availability status of the vehicle in inventory.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the current inventory status.</inlineHelpText>
        <label>Inventory Status</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Available</fullName>
                    <default>true</default>
                    <label>Available</label>
                </value>
                <value>
                    <fullName>Reserved</fullName>
                    <default>false</default>
                    <label>Reserved</label>
                </value>
                <value>
                    <fullName>Sold</fullName>
                    <default>false</default>
                    <label>Sold</label>
                </value>
                <value>
                    <fullName>In Transit</fullName>
                    <default>false</default>
                    <label>In Transit</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Stock_Number__c</fullName>
        <description>The internal dealership stock number assigned to this vehicle.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the dealership stock number.</inlineHelpText>
        <label>Stock Number</label>
        <length>20</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Date_Acquired__c</fullName>
        <description>The date the dealership acquired this vehicle.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the date this vehicle was acquired by the dealership.</inlineHelpText>
        <label>Date Acquired</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <label>Vehicle</label>
    <nameField>
        <displayFormat>VEH-{00000}</displayFormat>
        <label>Vehicle Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Vehicles</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
