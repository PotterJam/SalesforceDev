    <deploymentStatus>Deployed</deploymentStatus>
    <description>Defines a round robin rotation group for automated Lead assignment to Queues. Controls the active state, tracks the rotation pointer, and logs errors.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Read</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this round robin group is actively assigning Leads to its member Queues.</description>
        <externalId>false</externalId>
        <inlineHelpText>When checked, new Leads will be assigned to Queues in this group.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Error_Message__c</fullName>
        <description>Stores the most recent error message encountered during round robin assignment processing.</description>
        <externalId>false</externalId>
        <inlineHelpText>The last error encountered during assignment. Cleared on next successful assignment.</inlineHelpText>
        <label>Error Message</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Last_Assigned_Index__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Tracks the sort order index of the last member that received an assignment. Used to determine the next member in rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>The index of the last member assigned. The next assignment starts from the following member.</inlineHelpText>
        <label>Last Assigned Index</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Last_Error_Date__c</fullName>
        <description>Records the date and time when the most recent assignment error occurred.</description>
        <externalId>false</externalId>
        <inlineHelpText>When the last error occurred.</inlineHelpText>
        <label>Last Error Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Total_Assignments__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Running total of all Lead assignments made through this round robin group.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total number of Leads assigned through this group.</inlineHelpText>
        <label>Total Assignments</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Round Robin Group</label>
    <nameField>
        <displayFormat>RRG-{00000}</displayFormat>
        <label>Round Robin Group Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Groups</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
</CustomObject>
