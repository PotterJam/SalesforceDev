<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <assignments>
        <name>Set_Close_Date_Delivered</name>
        <label>Set Close Date Delivered</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
