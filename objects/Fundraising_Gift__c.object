    <deploymentStatus>Deployed</deploymentStatus>
    <description>A donation received or expected from a donor, representing a single gift transaction in the fundraising pipeline.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Donor__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The donor who made or is expected to make this gift.</description>
        <externalId>false</externalId>
        <label>Donor</label>
        <referenceTo>Fundraising_Donor__c</referenceTo>
        <relationshipLabel>Gifts</relationshipLabel>
        <relationshipName>Gifts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Campaign__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The fundraising campaign this gift is associated with.</description>
        <externalId>false</externalId>
        <label>Campaign</label>
        <referenceTo>Fundraising_Campaign__c</referenceTo>
        <relationshipLabel>Gifts</relationshipLabel>
        <relationshipName>Gifts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Appeal__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The specific appeal that prompted this gift.</description>
        <externalId>false</externalId>
        <label>Appeal</label>
        <referenceTo>Fundraising_Appeal__c</referenceTo>
        <relationshipLabel>Gifts</relationshipLabel>
        <relationshipName>Gifts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amount__c</fullName>
        <description>The monetary value of this gift.</description>
        <externalId>false</externalId>
        <label>Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Gift_Date__c</fullName>
        <description>The date the gift was received or is expected to be received.</description>
        <externalId>false</externalId>
        <label>Gift Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Stage__c</fullName>
        <description>The current stage of the gift in the fundraising pipeline.</description>
        <externalId>false</externalId>
        <label>Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Prospecting</fullName>
                    <default>true</default>
                    <label>Prospecting</label>
                </value>
                <value>
                    <fullName>Solicitation</fullName>
                    <default>false</default>
                    <label>Solicitation</label>
                </value>
                <value>
                    <fullName>Committed</fullName>
                    <default>false</default>
                    <label>Committed</label>
                </value>
                <value>
                    <fullName>Received</fullName>
                    <default>false</default>
                    <label>Received</label>
                </value>
                <value>
                    <fullName>Acknowledged</fullName>
                    <default>false</default>
                    <label>Acknowledged</label>
                </value>
                <value>
                    <fullName>Closed Lost</fullName>
                    <default>false</default>
                    <label>Closed Lost</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Payment_Method__c</fullName>
        <description>The method by which the gift was or will be made.</description>
        <externalId>false</externalId>
        <label>Payment Method</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Cash</fullName>
                    <default>false</default>
                    <label>Cash</label>
                </value>
                <value>
                    <fullName>Check</fullName>
                    <default>false</default>
                    <label>Check</label>
                </value>
                <value>
                    <fullName>Credit Card</fullName>
                    <default>false</default>
                    <label>Credit Card</label>
                </value>
                <value>
                    <fullName>ACH</fullName>
                    <default>false</default>
                    <label>ACH</label>
                </value>
                <value>
                    <fullName>Stock</fullName>
                    <default>false</default>
                    <label>Stock</label>
                </value>
                <value>
                    <fullName>In-Kind</fullName>
                    <default>false</default>
                    <label>In-Kind</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Tax_Deductible_Amount__c</fullName>
        <description>The portion of the gift amount that is tax-deductible for the donor.</description>
        <externalId>false</externalId>
        <label>Tax Deductible Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Fair_Market_Value__c</fullName>
        <description>The fair market value of in-kind or non-cash gifts for tax reporting purposes.</description>
        <externalId>false</externalId>
        <label>Fair Market Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Acknowledgment_Sent__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether a thank-you or tax acknowledgment letter has been sent to the donor.</description>
        <externalId>false</externalId>
        <label>Acknowledgment Sent</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Acknowledgment_Date__c</fullName>
        <description>The date the acknowledgment letter was sent to the donor.</description>
        <externalId>false</externalId>
        <label>Acknowledgment Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Is_Anonymous__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether the donor wishes to remain anonymous for this gift.</description>
        <externalId>false</externalId>
        <label>Is Anonymous</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Additional notes about this gift, such as donor intent, restrictions, or special instructions.</description>
        <externalId>false</externalId>
        <label>Notes</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <validationRules>
        <fullName>Gift_Tax_Deductible_Within_Amount</fullName>
        <active>true</active>
        <description>Ensures the tax deductible amount does not exceed the total gift amount.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(Tax_Deductible_Amount__c)), NOT(ISBLANK(Amount__c)), Tax_Deductible_Amount__c &gt; Amount__c)</errorConditionFormula>
        <errorDisplayField>Tax_Deductible_Amount__c</errorDisplayField>
        <errorMessage>Tax Deductible Amount cannot exceed the Gift Amount.</errorMessage>
    </validationRules>
    <label>Fundraising Gift</label>
    <nameField>
        <label>Gift Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Fundraising Gifts</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
