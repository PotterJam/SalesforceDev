    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents a user in a round-robin assignment group. Controls the rotation order and whether the user is currently active in the pool.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Group__c</fullName>
        <description>The round-robin group this member belongs to.</description>
        <externalId>false</externalId>
        <label>Group</label>
        <referenceTo>Round_Robin_Group__c</referenceTo>
        <relationshipLabel>Members</relationshipLabel>
        <relationshipName>Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The user who will be assigned Leads when it is their turn in the rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the user to include in this round-robin group.</inlineHelpText>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Round_Robin_Memberships</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sort_Order__c</fullName>
        <description>Determines the position of this member in the rotation sequence. Members are assigned in ascending sort order.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the position in the rotation (1, 2, 3, etc.).</inlineHelpText>
        <label>Sort Order</label>
        <precision>5</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this member receives Lead assignments. Inactive members are skipped in the rotation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily remove this user from the rotation without deleting the record.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Round Robin Member</label>
    <nameField>
        <displayFormat>RRM-{00000}</displayFormat>
        <label>Round Robin Member Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Members</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
