    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Configuration object for round-robin Lead assignment. Each group defines eligibility criteria and contains a pool of users to distribute Leads across.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Controls whether this group participates in round-robin assignment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Uncheck to temporarily disable this group without deleting it.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Administrative notes about this round-robin group.</description>
        <externalId>false</externalId>
        <inlineHelpText>Describe the purpose of this group and when it applies.</inlineHelpText>
        <label>Description</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <length>500</length>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Last_Assigned_Index__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Tracks the position of the last assigned member in the rotation sequence.</description>
        <externalId>false</externalId>
        <inlineHelpText>Automatically updated by the system. Do not modify manually.</inlineHelpText>
        <label>Last Assigned Index</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <precision>5</precision>
        <scale>0</scale>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Lead_Source_Criteria__c</fullName>
        <description>Comma-separated list of Lead Source values. Leads with a matching Lead Source are eligible for this group. Leave blank to match any Lead Source.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter Lead Source values separated by commas (e.g. Web,Phone Inquiry,Partner). Leave blank to match all.</inlineHelpText>
        <label>Lead Source Criteria</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <length>255</length>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Country_Criteria__c</fullName>
        <description>Comma-separated list of Country values. Leads with a matching Country are eligible for this group. Leave blank to match any Country.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter Country values separated by commas (e.g. US,CA,UK). Leave blank to match all.</inlineHelpText>
        <label>Country Criteria</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <length>255</length>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Rating_Criteria__c</fullName>
        <description>Comma-separated list of Rating values. Leads with a matching Rating are eligible for this group. Leave blank to match any Rating.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter Rating values separated by commas (e.g. Hot,Warm). Leave blank to match all.</inlineHelpText>
        <label>Rating Criteria</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <length>255</length>
        <required>false</required>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Priority__c</fullName>
        <defaultValue>1</defaultValue>
        <description>Determines which group takes precedence when a Lead matches multiple groups. Lower numbers indicate higher priority.</description>
        <externalId>false</externalId>
        <inlineHelpText>Lower number = higher priority. When a Lead matches multiple groups, the lowest priority number wins.</inlineHelpText>
        <label>Priority</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <precision>3</precision>
        <scale>0</scale>
        <required>true</required>
        <unique>false</unique>
    </fields>
    <label>Round Robin Group</label>
    <nameField>
        <displayFormat>RRG-{00000}</displayFormat>
        <label>Round Robin Group Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Round Robin Groups</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
