    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Audit log recording each Lead round-robin assignment attempt, including successful assignments and errors for troubleshooting.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Read</externalSharingModel>
    <fields>
        <fullName>Assigned_Date__c</fullName>
        <description>The date and time when the assignment was attempted.</description>
        <externalId>false</externalId>
        <inlineHelpText>When the assignment occurred.</inlineHelpText>
        <label>Assigned Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Error_Message__c</fullName>
        <description>Detailed error information when the assignment fails, including exception message and stack trace.</description>
        <externalId>false</externalId>
        <inlineHelpText>Error details if the assignment failed.</inlineHelpText>
        <label>Error Message</label>
        <length>5000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Lead__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Lead that was assigned or attempted to be assigned.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Lead record.</inlineHelpText>
        <label>Lead</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Round Robin Logs</relationshipLabel>
        <relationshipName>Round_Robin_Logs</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Queue_Id__c</fullName>
        <description>The 18-character Id of the Queue the Lead was assigned to.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Queue Id at time of assignment.</inlineHelpText>
        <label>Queue Id</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Queue_Name__c</fullName>
        <description>The name of the Queue at the time of assignment for historical reference.</description>
        <externalId>false</externalId>
        <inlineHelpText>Queue name at time of assignment.</inlineHelpText>
        <label>Queue Name</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Indicates whether the assignment was successful or encountered an error.</description>
        <externalId>false</externalId>
        <inlineHelpText>The outcome of the assignment attempt.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Lead Round Robin Log</label>
    <nameField>
        <displayFormat>RRL-{00000}</displayFormat>
        <label>Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Lead Round Robin Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
