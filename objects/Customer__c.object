    <fields>
        <fullName>Credit_Score_Range__c</fullName>
        <description>The customer's approximate credit score range for financing eligibility assessment.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select the customer's credit score range.</inlineHelpText>
        <label>Credit Score Range</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Excellent (750+)</fullName>
                    <default>false</default>
                    <label>Excellent (750+)</label>
                </value>
                <value>
                    <fullName>Good (700-749)</fullName>
                    <default>false</default>
                    <label>Good (700-749)</label>
                </value>
                <value>
                    <fullName>Fair (650-699)</fullName>
                    <default>false</default>
                    <label>Fair (650-699)</label>
                </value>
                <value>
                    <fullName>Below Average (below 650)</fullName>
                    <default>false</default>
                    <label>Below Average (below 650)</label>
                </value>
                <value>
                    <fullName>Unknown</fullName>
                    <default>true</default>
                    <label>Unknown</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
