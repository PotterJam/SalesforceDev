    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Records every Lead assignment attempt made by the round-robin system. Provides an audit trail for troubleshooting, reporting, and compliance.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Assignment_Pool__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The assignment pool that processed this Lead assignment attempt.</description>
        <externalId>false</externalId>
        <inlineHelpText>The pool used for this assignment.</inlineHelpText>
        <label>Assignment Pool</label>
        <referenceTo>Lead_Assignment_Pool__c</referenceTo>
        <relationshipLabel>Assignment Logs</relationshipLabel>
        <relationshipName>Assignment_Logs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Lead__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Lead record that was assigned or attempted to be assigned.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Lead that was processed.</inlineHelpText>
        <label>Lead</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Assignment Logs</relationshipLabel>
        <relationshipName>Assignment_Logs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Assigned_To__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The user who received the Lead assignment. Null if assignment failed.</description>
        <externalId>false</externalId>
        <inlineHelpText>The user the Lead was assigned to.</inlineHelpText>
        <label>Assigned To</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Lead_Assignment_Logs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>The outcome of the assignment attempt. Success indicates normal rotation, Fallback indicates no eligible member was found, Error indicates a system failure.</description>
        <externalId>false</externalId>
        <inlineHelpText>The result of this assignment attempt.</inlineHelpText>
        <label>Status</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Fallback</fullName>
                    <default>false</default>
                    <label>Fallback</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Error_Message__c</fullName>
        <description>Detailed error or informational message about the assignment attempt. Populated on failures and fallback scenarios.</description>
        <externalId>false</externalId>
        <inlineHelpText>Details about the assignment outcome, especially for errors.</inlineHelpText>
        <label>Error Message</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Assigned_Date__c</fullName>
        <description>The date and time when the assignment was processed.</description>
        <externalId>false</externalId>
        <inlineHelpText>When this assignment was processed.</inlineHelpText>
        <label>Assigned Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <label>Lead Assignment Log</label>
    <nameField>
        <displayFormat>LAL-{00000}</displayFormat>
        <label>Lead Assignment Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Lead Assignment Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
